# CampusHub Geospatial & Mapbox Environment Configuration
# Optional: Provide a valid Mapbox Public Access Token to enable Mapbox Directions API for walking routing.
# If omitted or empty, CampusHub will automatically route via OpenStreetMap (OSRM) and high-precision campus topological routing.
VITE_MAPBOX_ACCESS_TOKEN=

# CampusHub Backend API Port (Default: 3001)
PORT=3001

# Optional: Remote Supabase Cloud PostgreSQL Database
# If provided, CampusHub can sync directly with Supabase Cloud
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
